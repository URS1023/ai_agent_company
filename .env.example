APP_ENV=local
DEBUG=0

# Web/API listener. 0.0.0.0 allows devices on the same LAN to reach the
# single FastAPI origin that serves both the platform UI and API.
HOST=0.0.0.0
PORT=8011
# Optional HTTPS listener: provide both paths, or leave both empty for HTTP.
SSL_CERTFILE=
SSL_KEYFILE=
# Same-origin use does not require CORS. Keep * only for trusted development
# LANs; production deployments should list their exact HTTPS origins.
CORS_ORIGINS=*

# Optional OpenAI Responses-compatible endpoint used by 1.py.
RESPONSES_API_BASE_URL=http://127.0.0.1:8000
RESPONSES_API_KEY=
RESPONSES_API_MODEL=gpt-5.6-luna

AGNES_BASE_URL=
AGNES_API_KEY=
AGNES_CHAT_MODEL=agnes-2.5-flash

SILICONFLOW_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3
SILICONFLOW_EMBED_DIM=1024
SILICONFLOW_VISION_MODEL=Qwen/Qwen3.5-4B
SILICONFLOW_VISION_API_KEY=
VISION_ENABLED=1
VISION_DETAIL=high
VISION_MAX_IMAGES_PER_DOCUMENT=16
VISION_MAX_IMAGE_EDGE=2200
VISION_MIN_IMAGE_SIDE=72
VISION_MAX_OUTPUT_TOKENS=1400
VISION_PDF_DPI=144
PRESENTATION_PPT_MASTER_ROOT=
PRESENTATION_AIPPT_ROOT=
PRESENTATION_EXTERNAL_SERVICES_ENABLED=0
# Optional real PPTX thumbnail renderer. Leave empty to auto-detect the bundled Codex runtime.
PRESENTATION_PREVIEW_NODE=
PRESENTATION_PREVIEW_NODE_MODULES=
AGENT_CONTEXT_MAX_CHARS=260000
AGENT_TOOL_RESULT_MAX_CHARS=50000
READ_FILE_DEFAULT_MAX_CHARS=30000
READ_FILE_MAX_CHARS=80000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
PLATFORM_DB=company_agent
DEMO_DB=demo_finance

REDIS_URL=redis://127.0.0.1:6379/0
ES_URL=http://127.0.0.1:9200
LOCAL_STORAGE_ROOT=storage
SECRET_MASTER_KEY=replace-with-a-random-production-key
BOOTSTRAP_ADMIN_PASSWORD=replace-before-deployment
BOOTSTRAP_LYNX_REPORTS=1

# 0: no total chat deadline; per-query and sandbox protections remain enabled.
CHAT_TASK_TIMEOUT_SECONDS=0

# 对话引擎迁移开关：试点使用 harness，回退新增运行使用 openwebui。
# 已接收的任务使用自己的引擎快照；修改后按项目部署方式重启 API。
CHAT_ENGINE=openwebui
HARNESS_NODE=node
# 留空不覆盖默认路径；自定义时填绝对路径。默认由 scripts/install_harness.py 构建。
# HARNESS_UPSTREAM_ROOT=E:/path/to/isolated/deepseek-harness
# HARNESS_HOME_ROOT=E:/path/to/private/harness-data
HARNESS_MAX_PROCESSES=2
HARNESS_START_TIMEOUT_SECONDS=60
HARNESS_CANCEL_TIMEOUT_SECONDS=30
# 仅作为没有单模型元数据时的保守默认，正式模型优先设置 runtime_options。
HARNESS_CONTEXT_WINDOW=32768
HARNESS_MAX_OUTPUT_TOKENS=4096
# 按名称显式放行已经审查的企业连接器；通用脚本和任意文件修改仍被拒绝。
HARNESS_EXTRA_TOOLS=

# 后端节点日志：默认 storage/logs；每个进程分别保存综合日志和 AI 对话日志。
LOG_DIR=
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
