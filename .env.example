# 启动脚本只读取当前进程中明确设置的AGENT_变量，不自动加载此文件。
AGENT_DATA_DIR=.local/platform
AGENT_ENV=development
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173
AGENT_ENABLED_MODULES=
AGENT_ALLOW_REMOTE_CONNECTIONS=false
# 生产环境使用独立保管的Fernet密钥；不要提交真实值。
# AGENT_MASTER_KEY=
# 默认创建平台专用SQLite文件，不继承旧系统连接。
# AGENT_DATABASE_URL=
