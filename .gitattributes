* text=auto

# Windows entry points remain directly runnable after checkout.
*.bat text eol=crlf
*.ps1 text eol=crlf

# SQL dumps are byte-addressed migration evidence; do not rewrite line endings.
*.sql -text

# Binary assets and generated business artifacts.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.pdf binary

# 构建包保留第三方模板字符串，字符串行尾空格不作为源码空白错误。
apps/web/assets/analytics/assets/*.js whitespace=-blank-at-eol
