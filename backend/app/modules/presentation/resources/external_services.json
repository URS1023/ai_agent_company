{
  "schema": "presentation_external_resources.v1",
  "services": [
    {
      "id": "docmee-aippt-reference",
      "name": "文多多 AiPPT",
      "source_project": "AiPPT",
      "capabilities": [
        "outline_generation",
        "template_gallery",
        "streaming_page_generation",
        "pptx_to_json",
        "json_to_pptx"
      ],
      "license": "GPL-3.0",
      "integration_mode": "reference_adapter",
      "enabled_by_default": false,
      "credential_policy": "secret_reference_only",
      "notes": "保留接口与产品流程参考；不使用示例硬编码 API Key，不自动调用外部服务。"
    },
    {
      "id": "ppt-master-optional-adapters",
      "name": "PPT Master 可选资源适配器",
      "source_project": "ppt-master",
      "capabilities": [
        "image_generation",
        "image_search",
        "tts",
        "audio_narration",
        "animation",
        "video_export"
      ],
      "license": "MIT with third-party asset notices",
      "integration_mode": "optional_local_adapter",
      "enabled_by_default": false,
      "credential_policy": "secret_reference_only",
      "notes": "保留脚本和配置；只有用户明确需要相应交付物时才启用。"
    }
  ]
}
