{
  "id": "01M257SW2RNQ4JEM3VK0KGAQQ9",
  "name": "出厂检测原始数据 · 按产品与要求读取",
  "category": "工作流读取值",
  "content": "SELECT d.incomingMaterialQcItemDetails2Id recordKey,\n                h.incomingMaterialQcFormId AS `单据标识`,h.c_incomingQcNo AS `质检单号`,d.c_timePoint AS `检测时间`,\n                d.c_luyanshu AS `炉眼`,d.c_faqiliang AS `发气量_L每kg`,\n                d.c_linhuaqing AS `磷化氢_百分比`,d.c_liuhuaqing AS `硫化氢_百分比`,d.c_jieguo AS `原检验结果`\n                FROM t_incomingmaterialqcitemdetails2 d JOIN t_incomingmaterialqcform h\n                ON h.incomingMaterialQcFormId=d.mdIncomingMaterialQcFormId AND h.isDeleted=0\n                WHERE (:formNumber='' OR h.c_incomingQcNo=:formNumber) AND d.isDeleted=0 AND h.c_qualityInspection=:category AND (\n (:qualityTemplate<>'' AND h.c_qualityInspectionTemplate=:qualityTemplate)\n OR (:qualityTemplate='' AND (h.c_qualityInspectionTemplate IS NULL OR h.c_qualityInspectionTemplate=''))\n) ORDER BY d.incomingMaterialQcItemDetails2Id",
  "mode": "sql",
  "parameters": {
