  "name": "统计明细原始数据 · 按产品与要求读取",
  "category": "工作流读取值",
  "content": "SELECT d.zhijianxiangmutongjimingxiId recordKey,\n            h.incomingMaterialQcFormId AS `单据标识`,h.c_incomingQcNo AS `质检单号`,d.`c_n0001` AS `有效氧化钙（%）1_c_n0001`,d.`c_n0002` AS `氧化镁（%）_c_n0002`,d.`c_n0003` AS `生过烧（%）_c_n0003`,d.`c_n0004` AS `盐酸不溶物（%）_c_n0004`,d.`c_n0005` AS `三氧化二物（%）_c_n0005`,d.`c_n0006` AS `活性度（%）_c_n0006`,d.`c_n0007` AS `粒度（≤10mm）（%）_c_n0007`,d.`c_n0008` AS `外水分 （%）_c_n0008`,d.`c_n0009` AS `内水分（%）_c_n0009`,d.`c_n0010` AS `灰分（%）_c_n0010`,d.`c_n0011` AS `挥发分（%）_c_n0011`,d.`c_n0012` AS `固定碳（%）_c_n0012`,d.`c_n0013` AS `硫（%）_c_n0013`,d.`c_n0014` AS `氧化钙(%)_c_n0014`,d.`c_n0015` AS `二氧化硅(%)_c_n0015`,d.`c_n0016` AS `粒度（40-80）mm(%)_c_n0016`,d.`c_n0017` AS `水分(%)_c_n0017`,d.`c_n0018` AS `粒度（≤10mm）（%）_c_n0018`,d.`c_n0052` AS `氧化镁_c_n0052`,d.`c_n0053` AS `三氧化二物_c_n0053`,d.`c_n0054` AS `固定碳（%）_c_n0054`,d.`c_n0055` AS `灰份（%）_c_n0055`,d.`c_n0056` AS `挥发份（%）_c_n0056`\n            FROM t_zhijianxiangmutongjimingxi d JOIN t_incomingmaterialqcform h\n            ON h.incomingMaterialQcFormId=d.mdIncomingMaterialQcFormId AND h.isDeleted=0\n            WHERE (:formNumber='' OR h.c_incomingQcNo=:formNumber) AND d.isDeleted=0 AND h.c_qualityInspection=:category AND (\n (:qualityTemplate<>'' AND h.c_qualityInspectionTemplate=:qualityTemplate)\n OR (:qualityTemplate='' AND (h.c_qualityInspectionTemplate IS NULL OR h.c_qualityInspectionTemplate=''))\n) ORDER BY d.zhijianxiangmutongjimingxiId",
