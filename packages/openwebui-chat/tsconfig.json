{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": ["../../apps/web/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "public.ts", "vite.config.ts"]
}
