  "rejectedSql": "SELECT `c`.`c_custName` AS `客户名称`, `p`.`c_contractNo` AS `合同号`, `p`.`c_contractName` AS `合同名称或款项名称`, `p`.`c_contractAmount` AS `合同金额_元`, `p`.`c_pamented` AS `已付金额_元`, `p`.`c_unpayment` AS `未付金额_元`, `p`.`c_requestPament` AS `本次申请支付金额`, `p`.`c_payee` AS `收款单位`, `p`.`c_bumen` AS `部门`, `p`.`c_xuhao` AS `序号`, `pl`.`c_plandDate` AS `计划日期`, `pl`.`c_zijinzhifubianhao` AS `资金支付编号`, `pl`.`c_zijinzhifudanmingcheng` AS `资金支付单名称`, `pl`.`approvalStatus` AS `审批状态` FROM `t_summaryoffundpayments` AS `p` LEFT JOIN `t_summaryoffundpaymentplan` AS `pl` ON `p`.`mdSummaryofFundPaymentPlanId` = `pl`.`summaryofFundPaymentPlanId` LEFT JOIN `t_custbaseinfo` AS `c` ON `c`.`c_custName` = `p`.`c_payee` WHERE `p`.`isDeleted` = 0 AND `pl`.`c_plandDate` >= DATE_FORMAT(DATE_SUB(CURRENT_DATE, INTERVAL '1' MONTH), '%Y-%m-01') AND `pl`.`c_plandDate` < DATE_FORMAT(CURRENT_DATE, '%Y-%m-01') ORDER BY `pl`.`c_plandDate`, `p`.`c_xuhao` LIMIT 100"
}
